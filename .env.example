# RETROVA - Configuration d'environnement

# Serveur
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=1

# Base de données
# Railway / PostgreSQL (si activé plus tard)
DATABASE_URL=
# SQLite local par défaut pour le développement et la compatibilité actuelle
DATABASE_PATH=./database/database.sqlite

# Sessions
SESSION_SECRET=

# Compte administrateur initial
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# Cloudinary (permanent image storage in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optionnel pour V1)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# URLs
SITE_URL=https://retroova.com
BASE_URL=https://retroova.com
