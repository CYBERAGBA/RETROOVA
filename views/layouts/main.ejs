<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'fr' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : t('seo.homeDescription', 'RETROOVA aide à retrouver les objets perdus et à remettre en contact les personnes qui ont trouvé un bien avec son propriétaire.') %>">
    <meta property="og:title" content="<%= title %> | RETROOVA">
    <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : t('seo.homeDescription', 'RETROOVA aide à retrouver les objets perdus et à remettre en contact les personnes qui ont trouvé un bien avec son propriétaire.') %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : siteUrl %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : (siteUrl + '/images/logo_nom_slogan_paysage.png') %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %> | RETROOVA">
    <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : t('seo.homeDescription', 'RETROOVA aide à retrouver les objets perdus et à remettre en contact les personnes qui ont trouvé un bien avec son propriétaire.') %>">
    <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : siteUrl %>">
    <% if (typeof alternateLinks !== 'undefined' && alternateLinks) { %>
        <%- alternateLinks %>
    <% } %>
    <% if (typeof schemaJsonLd !== 'undefined' && schemaJsonLd) { %>
        <script type="application/ld+json"><%- JSON.stringify(schemaJsonLd) %></script>
    <% } %>
    <% if (typeof faqSchema !== 'undefined' && faqSchema) { %>
        <script type="application/ld+json"><%- JSON.stringify(faqSchema) %></script>
    <% } %>
    <title>
        <%= title %> | RETROOVA
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo_lettre_R.png">
</head>

<body>
    <%- include('../partials/header') %>

        <main class="container">
            <% if (typeof errors !=='undefined' && errors.length> 0) { %>
                <div class="alert alert-danger">
                    <% errors.forEach(error=> { %>
                        <p>❌ <%= error %>
                        </p>
                        <% }); %>
                </div>
                <% } %>

                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger">
                            <p>❌ <%= error %>
                            </p>
                        </div>
                        <% } %>

                            <% if (typeof message !=='undefined' && message) { %>
                                <div class="alert alert-success">
                                    <p>✅ <%= message %>
                                    </p>
                                </div>
                                <% } %>

                                    <%- body %>
        </main>

        <%- include('../partials/footer') %>
</body>

</html>