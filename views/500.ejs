<%
const errorDetails = typeof error !== 'undefined' && error
    ? `
        <div class="error-details">
            <p><strong>${t('messages.details', 'Détails :')}</strong> ${error}</p>
        </div>
    `
    : '';
%>
<%- include('./layouts/main', {
    title: t('messages.serverError', 'Erreur serveur'),
    metaDescription: t('messages.tryAgain', 'Une erreur est survenue. Veuillez réessayer plus tard.'),
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : siteUrl,
    body: `
<div class="error-container">
    <div class="error-card">
        <h1 class="error-code">500</h1>
        <h2>${t('messages.serverError', 'Erreur serveur')}</h2>
        <p>${t('messages.tryAgain', 'Une erreur est survenue. Veuillez réessayer plus tard.')}</p>
        ${errorDetails}
        <a href="/" class="btn btn-primary">${t('messages.returnHome', "Retourner à l'accueil")}</a>
    </div>
</div>
`
}) %>