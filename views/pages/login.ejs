<%- include('../partials/header') %>
    <main class="container">
        <div class="auth-container">
            <div class="auth-card">
                <img src="/images/logo_nom_slogan_paysage.png" alt="RETROOVA" class="auth-brand-logo">
                <h1><%= t('auth.loginTitle', 'Connexion') %></h1>
                <p><%= t('auth.loginSubtitle', 'Bienvenue sur la plateforme de restitution d\'objets') %></p>

                <% if (typeof message !=='undefined' && message) { %>
                    <div class="alert alert-success">
                        <p>✅ <%= message %>
                        </p>
                    </div>
                    <% } %>

                        <% if (typeof errors !=='undefined' && errors.length> 0) { %>
                            <div class="alert alert-danger">
                                <% errors.forEach(error=> { %>
                                    <p>❌ <%= error %>
                                    </p>
                                    <% }); %>
                            </div>
                            <% } %>

                                <form method="POST" action="/<%= locale === 'en' ? 'en/' : 'fr/' %>login" class="auth-form"><input type="hidden" name="_csrf"
                                        value="<%= csrfToken %>">
                                    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>">
                                    <div class="form-group">
                                        <label for="email"><%= t('common.email', 'Email') %></label>
                                        <input type="email" id="email" name="email" placeholder="votre@email.com"
                                            value="<%= formData?.email || '' %>" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="password"><%= t('common.password', 'Mot de passe') %></label>
                                        <input type="password" id="password" name="password"
                                            placeholder="<%= t('auth.passwordPlaceholder', 'Votre mot de passe') %>" required>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-block"><%= t('auth.submitLogin', 'Se connecter') %></button>
                                </form>
                                <p class="auth-legal"><%= t('auth.loginLegalPrefix', 'En utilisant RETROOVA, vous acceptez nos') %> <a href="/<%= locale === 'en' ? 'en' : 'fr' %>/terms"><%= t('auth.termsLink', 'Conditions d’utilisation') %></a> <%= t('auth.loginLegalAnd', 'et reconnaissez notre') %> <a href="/<%= locale === 'en' ? 'en' : 'fr' %>/privacy"><%= t('auth.privacyLink', 'Politique de confidentialité') %></a>.</p>

                                <div class="auth-divider"><%= t('common.or', 'ou') %></div>

                                <p class="auth-link">
                                    <%= t('auth.noAccount', 'Vous n\'avez pas de compte ?') %> <a href="/<%= locale === 'en' ? 'en' : 'fr' %>/register"><%= t('auth.signUp', 'S\'inscrire') %></a>
                                </p>

            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>