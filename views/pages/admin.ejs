<%- include('../partials/header') %>
    <main class="container">
        <div class="page-heading"><span class="eyebrow">ESPACE ADMINISTRATEUR</span>
            <h1>Pilotage RETROOVA</h1>
            <p>Modérez les annonces et surveillez l’activité de la plateforme.</p>
        </div>
        <section class="admin-stats">
            <div><strong>
                    <%= overview.users %>
                </strong><span>Utilisateurs</span></div>
            <div><strong>
                    <%= overview.lost %>
                </strong><span>Objets perdus</span></div>
            <div><strong>
                    <%= overview.found %>
                </strong><span>Objets trouvés</span></div>
            <div><strong>
                    <%= overview.matches %>
                </strong><span>Correspondances</span></div>
            <div><strong>
                    <%= overview.pending_reports %>
                </strong><span>Signalements à traiter</span></div>
        </section>
        <section class="admin-panel">
            <div class="panel-heading">
                <h2>Utilisateurs</h2><span>
                    <%= users.length %> affichés
                </span>
            </div>
            <div class="admin-table">
                <% users.forEach(account=> { %><div><span class="type-pill">
                            <%= account.role %>
                        </span><strong>
                            <%= account.name %>
                        </strong><span>
                            <%= account.email %> · <%= account.city || 'Ville non précisée' %>
                        </span><span>
                            <%= account.status %>
                        </span></div>
                    <% }) %>
            </div>
        </section>
        <section class="admin-panel">
            <div class="panel-heading">
                <h2>Signalements</h2><span>
                    <%= reports.length %> récents
                </span>
            </div>
            <% if (!reports.length) { %>
                <div class="empty-state">
                    <p>Aucun signalement.</p>
                </div>
                <% } else { reports.forEach(report=> { %><article class="report-row">
                        <div><strong>
                                <%= report.item_title %>
                            </strong>
                            <p>
                                <%= report.reason %> · par <%= report.reporter_name %>
                            </p><small>
                                <%= report.description || 'Sans précision' %>
                            </small>
                        </div>
                        <form method="POST" action="/admin/reports/<%= report.id %>"><input type="hidden" name="_csrf"
                                value="<%= csrfToken %>"><select name="status">
                                <option value="pending" <%=report.status==='pending' ? 'selected' : '' %>>En attente
                                </option>
                                <option value="reviewed" <%=report.status==='reviewed' ? 'selected' : '' %>>Examiné
                                </option>
                                <option value="resolved" <%=report.status==='resolved' ? 'selected' : '' %>>Résolu
                                </option>
                                <option value="dismissed" <%=report.status==='dismissed' ? 'selected' : '' %>>Rejeté
                                </option>
                            </select><input name="notes" placeholder="Note admin"
                                value="<%= report.admin_notes || '' %>"><button class="btn btn-small btn-primary">Mettre
                                à
                                jour</button></form>
                    </article>
                    <% }) } %>
        </section>
        <section class="admin-panel">
            <div class="panel-heading">
                <h2>Annonces récentes</h2><a href="/search">Ouvrir la recherche</a>
            </div>
            <div class="admin-table">
                <% items.forEach(item=> { %><div><span class="type-pill <%= item.type %>">
                            <%= item.type %>
                        </span><strong>
                            <%= item.title %>
                        </strong><span>
                            <%= item.city %> · <%= item.owner_name %>
                        </span><a href="/items/<%= item.id %>">Voir</a>
                        <form method="POST" action="/admin/items/<%= item.id %>/status"
                            data-confirm="Fermer cette annonce ?"><input type="hidden" name="_csrf"
                                value="<%= csrfToken %>"><input type="hidden" name="status" value="closed"><button
                                class="btn btn-small btn-danger">Fermer</button></form>
                    </div>
                    <% }) %>
            </div>
        </section>
        <section class="admin-panel">
            <div class="panel-heading">
                <h2>Utilisateurs</h2><span>
                    <%= users.length %> affichés
                </span>
            </div>
            <div class="admin-table">
                <% users.forEach(account=> { %><div><span class="type-pill">
                            <%= account.role %>
                        </span><strong>
                            <%= account.name %>
                        </strong><span>
                            <%= account.email %>
                        </span>
                        <form method="POST" action="/admin/users/<%= account.id %>/status"><input type="hidden"
                                name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status"
                                value="<%= account.status === 'suspended' ? 'active' : 'suspended' %>"><button
                                class="btn btn-small btn-secondary">
                                <%= account.status==='suspended' ? 'Réactiver' : 'Suspendre' %>
                            </button></form>
                    </div>
                    <% }) %>
            </div>
        </section>
    </main>
    <%- include('../partials/footer') %>