<%- include('../partials/header') %>
    <main class="container dashboard-page">
        <section class="dashboard-welcome">
            <div><span class="eyebrow">TABLEAU DE BORD</span><h1>Bonjour, <%= (user?.name || 'membre').split(' ')[0] %> <span aria-hidden="true">👋</span></h1><p>Voici ce qui se passe actuellement avec vos objets.</p></div>
            <p class="reputation-badge <%= reputation?.tone || 'standard' %>"><%= reputation?.tone === 'success' ? 'Bonne réputation' : reputation?.tone === 'danger' ? 'Compte sous surveillance' : 'Réputation standard' %><span>·</span><%= reputation?.level || 'Nouveau membre' %></p>
        </section>

        <section class="dashboard-match-banner">
            <div class="match-symbol">✦</div><div class="match-copy"><span class="section-label">À REGARDER EN PRIORITÉ</span><h2><%= itemStats?.matches || 0 %> correspondance<%= itemStats?.matches !== 1 ? 's' : '' %> potentielle<%= itemStats?.matches !== 1 ? 's' : '' %></h2><p><%= itemStats?.matches ? 'RETROOVA a trouvé des annonces qui pourraient correspondre à vos objets.' : 'RETROOVA continue de rechercher des correspondances pour vous.' %></p></div><a href="/matches" class="btn btn-primary">Voir les correspondances <span>→</span></a>
        </section>

        <section class="dashboard-stat-grid" aria-label="Résumé de vos objets">
            <div class="dashboard-stat accent-blue"><span class="stat-index">01</span><strong><%= itemStats?.lost || 0 %></strong><p>Objets perdus</p><a href="/lost/my-items">Mes déclarations <span>→</span></a></div>
            <div class="dashboard-stat accent-orange"><span class="stat-index">02</span><strong><%= itemStats?.found || 0 %></strong><p>Objets trouvés</p><a href="/found/my-items">Mes trouvailles <span>→</span></a></div>
            <div class="dashboard-stat accent-navy"><span class="stat-index">03</span><strong><%= itemStats?.matches || 0 %></strong><p>Correspondances</p><a href="/matches">Explorer <span>→</span></a></div>
            <div class="dashboard-stat accent-green"><span class="stat-index">04</span><strong><%= itemStats?.returned || 0 %></strong><p>Objets restitués</p><a href="/profile">Mon profil <span>→</span></a></div>
        </section>

        <div class="dashboard-main-grid">
            <section class="dashboard-surface">
                <div class="surface-heading"><div><span class="section-label">VOTRE INVENTAIRE</span><h2>Mes objets</h2></div><a class="text-link" href="/lost/my-items">Voir tous mes objets <span>→</span></a></div>
                <% if (items?.length) { %><div class="dashboard-items-list"><% items.forEach(item => { %><article class="dashboard-item-row"><% if (item.photo_url) { %><img src="<%= item.photo_url %>" alt="<%= item.title %>"><% } else { %><div class="item-placeholder"><%= item.type === 'lost' ? '⌕' : '✓' %></div><% } %><div class="dashboard-item-copy"><span class="item-type <%= item.type %>"><%= item.type === 'lost' ? 'Objet perdu' : 'Objet trouvé' %></span><h3><%= item.title %></h3><p><%= item.city %><%= item.event_date ? ' · ' + new Date(item.event_date).toLocaleDateString('fr-FR') : '' %></p></div><span class="item-status <%= item.status %>"><%= item.status === 'active' ? 'Actif' : item.status === 'returned' ? 'Restitué' : item.status === 'closed' ? 'Fermé' : item.status %></span><a class="row-arrow" href="/items/<%= item.id %>" aria-label="Voir <%= item.title %>">→</a></article><% }) %></div><% } else { %><div class="empty-state"><span>⌕</span><p>Vous n'avez encore déclaré aucun objet.</p><a class="btn btn-secondary" href="/lost/create">Déclarer un objet</a></div><% } %>
            </section>

            <section class="dashboard-surface">
                <div class="surface-heading"><div><span class="section-label">DERNIERS SIGNES</span><h2>Activité récente</h2></div><span class="surface-mark">05</span></div>
                <% if (activity?.length) { %><div class="activity-list"><% activity.forEach(entry => { %><article class="activity-entry"><span class="activity-icon"><%= entry.type === 'match' ? '✦' : entry.type === 'message' ? '✉' : '•' %></span><div><strong><%= entry.title %></strong><p><%= entry.detail %></p></div><time><%= entry.date ? new Date(entry.date).toLocaleDateString('fr-FR') : '' %></time></article><% }) %></div><% } else { %><div class="empty-state"><span>✦</span><p>Votre activité apparaîtra ici.</p></div><% } %>
            </section>
        </div>

        <section class="dashboard-bottom-row"><div><span class="section-label">BESOIN D'AGIR</span><h2>Un objet mérite votre attention ?</h2><p>Déclarez une perte ou une trouvaille pour aider la communauté RETROOVA.</p></div><div class="quick-actions"><a href="/lost/create" class="btn btn-primary">Déclarer un objet perdu</a><a href="/found/create" class="btn btn-success">Déclarer un objet trouvé</a></div></section>
    </main>
    <%- include('../partials/footer') %>
