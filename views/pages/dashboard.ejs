<%- include('../partials/header') %>
    <main class="container dashboard-page">
        <section class="dashboard-welcome">
            <div><span class="eyebrow"><%= t('dashboard.title', 'Tableau de bord') %></span><h1><%= t('dashboard.welcome', 'Bonjour') %>, <%= (user?.name || 'membre').split(' ')[0] %> <span aria-hidden="true">👋</span></h1><p><%= t('dashboard.summary', 'Voici ce qui se passe actuellement avec vos objets.') %></p></div>
            <p class="reputation-badge <%= reputation?.tone || 'standard' %>"><%= reputation?.tone === 'success' ? t('dashboard.reputationGood', 'Bonne réputation') : reputation?.tone === 'danger' ? t('dashboard.reputationWarning', 'Compte sous surveillance') : t('dashboard.reputationStandard', 'Réputation standard') %><span>·</span><%= reputation?.level || t('dashboard.memberNew', 'Nouveau membre') %></p>
        </section>

        <section class="dashboard-match-banner">
            <div class="match-symbol">✦</div><div class="match-copy"><span class="section-label"><%= t('dashboard.priority', 'À regarder en priorité') %></span><h2><%= itemStats?.matches || 0 %> <%= (itemStats?.matches === 1 ? t('dashboard.matchCount_one', 'correspondance potentielle') : t('dashboard.matchCount_other', 'correspondances potentielles')) %></h2><p><%= itemStats?.matches ? t('dashboard.matchesFound', '') : t('dashboard.matchesSearching', '') %></p></div><a href="/matches" class="btn btn-primary"><%= t('dashboard.viewMatches', 'Voir les correspondances') %> <span>→</span></a>
        </section>

        <section class="dashboard-stat-grid" aria-label="<%= t('dashboard.summaryLabel', 'Résumé de vos objets') %>">
            <div class="dashboard-stat accent-blue"><span class="stat-index">01</span><strong><%= itemStats?.lost || 0 %></strong><p><%= t('dashboard.statsLost', 'Objets perdus') %></p><a href="/lost/my-items"><%= t('common.viewAll', 'Voir tout') %> <span>→</span></a></div>
            <div class="dashboard-stat accent-orange"><span class="stat-index">02</span><strong><%= itemStats?.found || 0 %></strong><p><%= t('dashboard.statsFound', 'Objets trouvés') %></p><a href="/found/my-items"><%= t('dashboard.foundItemsLink', 'Mes trouvailles') %> <span>→</span></a></div>
            <div class="dashboard-stat accent-navy"><span class="stat-index">03</span><strong><%= itemStats?.matches || 0 %></strong><p><%= t('dashboard.statsMatches', 'Correspondances') %></p><a href="/matches"><%= t('dashboard.explore', 'Explorer') %> <span>→</span></a></div>
            <div class="dashboard-stat accent-green"><span class="stat-index">04</span><strong><%= itemStats?.returned || 0 %></strong><p><%= t('dashboard.statsReturned', 'Objets restitués') %></p><a href="/profile"><%= t('common.profile', 'Mon profil') %> <span>→</span></a></div>
        </section>

        <div class="dashboard-main-grid">
            <section class="dashboard-surface">
                <div class="surface-heading"><div><span class="section-label"><%= t('dashboard.inventoryLabel', 'VOTRE INVENTAIRE') %></span><h2><%= t('dashboard.myItems', 'Mes objets') %></h2></div><a class="text-link" href="/lost/my-items"><%= t('dashboard.seeAll', 'Voir tous mes objets') %> <span>→</span></a></div>
                <% if (items?.length) { %><div class="dashboard-items-list"><% items.forEach(item => { %><article class="dashboard-item-row"><% if (item.photo_url) { %><img src="<%= item.photo_url %>" alt="<%= item.title %>"><% } else { %><div class="item-placeholder"><%= item.type === 'lost' ? '⌕' : '✓' %></div><% } %><div class="dashboard-item-copy"><span class="item-type <%= item.type %>"><%= item.type === 'lost' ? t('dashboard.itemLost', 'Objet perdu') : t('dashboard.itemFound', 'Objet trouvé') %></span><h3><%= item.title %></h3><p><%= item.city %><%= item.event_date ? ' · ' + new Date(`${item.event_date}T00:00:00`).toLocaleDateString(locale === 'en' ? 'en-US' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '' %></p></div><span class="item-status <%= item.status %>"><%= item.status === 'active' ? t('dashboard.statusActive', 'Actif') : item.status === 'returned' ? t('dashboard.statusReturned', 'Restitué') : item.status === 'closed' ? t('dashboard.statusClosed', 'Fermé') : item.status %></span><a class="row-arrow" href="/items/<%= item.id %>" aria-label="<%= t('dashboard.viewItem', 'Voir') %> <%= item.title %>">→</a></article><% }) %></div><% } else { %><div class="empty-state"><span>⌕</span><p><%= t('dashboard.noItems', 'Vous n\'avez encore déclaré aucun objet.') %></p><a class="btn btn-secondary" href="/lost/create"><%= t('dashboard.declareItem', 'Déclarer un objet') %></a></div><% } %>
            </section>

            <section class="dashboard-surface">
                <div class="surface-heading"><div><span class="section-label"><%= t('dashboard.recentSigns', 'DERNIERS SIGNES') %></span><h2><%= t('dashboard.recentActivity', 'Activité récente') %></h2></div><span class="surface-mark">05</span></div>
                <% if (activity?.length) { %><div class="activity-list"><% activity.forEach(entry => { %><article class="activity-entry"><span class="activity-icon"><%= entry.type === 'match' ? '✦' : entry.type === 'message' ? '✉' : '•' %></span><div><strong><%= entry.title %></strong><p><%= entry.detail %></p></div><time><%= entry.date ? new Date(entry.date).toLocaleDateString(locale === 'en' ? 'en-US' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '' %></time></article><% }) %></div><% } else { %><div class="empty-state"><span>✦</span><p><%= t('dashboard.recentActivityText', 'Votre activité apparaîtra ici.') %></p></div><% } %>
            </section>
        </div>

        <section class="dashboard-bottom-row"><div><span class="section-label"><%= t('dashboard.needActionLabel', "BESOIN D'AGIR") %></span><h2><%= t('dashboard.needAction', 'Un objet mérite votre attention ?') %></h2><p><%= t('dashboard.callToAction', 'Déclarez une perte ou une trouvaille pour aider la communauté RETROOVA.') %></p></div><div class="quick-actions"><a href="/lost/create" class="btn btn-primary"><%= t('dashboard.declareLost', 'Déclarer un objet perdu') %></a><a href="/found/create" class="btn btn-success"><%= t('dashboard.declareFound', 'Déclarer un objet trouvé') %></a></div></section>
    </main>
    <%- include('../partials/footer') %>
