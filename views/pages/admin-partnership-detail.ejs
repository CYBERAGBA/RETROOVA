<%- include('../partials/header') %>
<main class="container">
  <div class="page-heading">
    <span class="eyebrow"><%= t('adminDetail.eyebrow', 'DEMANDE DE PARTENARIAT') %></span>
    <h1><%= request.organization_name %></h1>
  </div>

  <section class="admin-panel">
    <div class="detail-grid partnership-detail-grid">
      <div class="detail-item">
        <span><%= t('adminDetail.organization', 'Organisation') %></span>
        <strong><%= request.organization_name %></strong>
      </div>
      <div class="detail-item">
        <span><%= t('adminDetail.type', 'Type de partenariat') %></span>
        <strong><%= request.partnership_type %></strong>
      </div>
      <div class="detail-item">
        <span><%= t('adminDetail.contact', 'Contact') %></span>
        <strong><%= request.contact_name %></strong>
      </div>
      <div class="detail-item">
        <span><%= t('adminDetail.email', 'Email') %></span>
        <strong><a href="mailto:<%= request.email %>"><%= request.email %></a></strong>
      </div>
      <div class="detail-item">
        <span><%= t('adminDetail.country', 'Pays / Région') %></span>
        <strong><%= request.country || t('admin.unknown', 'Non précisé') %></strong>
      </div>
      <div class="detail-item">
        <span><%= t('adminDetail.received', 'Date de réception') %></span>
        <strong><%= new Date(request.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %> — <%= new Date(request.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></strong>
      </div>
    </div>

    <div class="detail-message-box">
      <h3><%= t('adminDetail.message', 'Message') %></h3>
      <p><%= request.message %></p>
    </div>

    <div class="partnership-status-panel">
      <h3><%= t('adminDetail.status', 'Statut') %></h3>
      <div class="partnership-status <%= request.status %>"><%= request.status === 'new' ? t('admin.statusNew', 'Nouveau') : request.status === 'in_progress' ? t('admin.statusInProgress', 'En cours') : request.status === 'accepted' ? t('admin.statusAccepted', 'Accepté') : request.status === 'archived' ? t('admin.statusArchived', 'Archivé') : t('admin.statusRejected', 'Rejeté') %></div>
    </div>

    <form method="POST" action="/admin/partnerships/<%= request.id %>" class="inline-form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="form-group">
        <span><%= t('adminDetail.notes', 'Notes admin') %></span>
        <textarea name="admin_notes" rows="4" placeholder="<%= t('adminDetail.notePlaceholder', 'Ajouter une note interne...') %>"><%= request.admin_notes || '' %></textarea>
      </label>
      <div class="admin-actions">
        <select name="status">
          <option value="new" <%= request.status === 'new' ? 'selected' : '' %>><%= t('admin.statusNew', 'Nouveau') %></option>
          <option value="in_progress" <%= request.status === 'in_progress' ? 'selected' : '' %>><%= t('admin.statusInProgress', 'En cours') %></option>
          <option value="accepted" <%= request.status === 'accepted' ? 'selected' : '' %>><%= t('admin.statusAccepted', 'Accepté') %></option>
          <option value="archived" <%= request.status === 'archived' ? 'selected' : '' %>><%= t('admin.statusArchived', 'Archivé') %></option>
          <option value="rejected" <%= request.status === 'rejected' ? 'selected' : '' %>><%= t('admin.statusRejected', 'Rejeté') %></option>
        </select>
        <button type="submit" class="btn btn-primary"><%= t('adminDetail.update', 'Mettre à jour') %></button>
      </div>
    </form>

    <form method="POST" action="/admin/partnerships/<%= request.id %>/delete" class="inline-form-stack danger-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-danger"><%= t('adminDetail.delete', 'Supprimer') %></button>
    </form>
  </section>
</main>
<%- include('../partials/footer') %>
