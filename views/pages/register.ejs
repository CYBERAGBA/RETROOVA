<%- include('../partials/header') %>
    <main class="container">
        <div class="auth-container">
            <div class="auth-card">
                <img src="/images/logo_nom_slogan_paysage.png" alt="RETROOVA" class="auth-brand-logo">
                <h1>Inscription</h1>
                <p>Rejoignez-nous pour retrouver vos objets perdus</p>

                <% if (typeof errors !=='undefined' && errors.length> 0) { %>
                    <div class="alert alert-danger">
                        <% errors.forEach(error=> { %>
                            <p>❌ <%= error %>
                            </p>
                            <% }); %>
                    </div>
                    <% } %>

                        <form method="POST" action="/register" class="auth-form"><input type="hidden" name="_csrf"
                                value="<%= csrfToken %>">
                            <div class="form-group">
                                <label for="name">Nom complet</label>
                                <input type="text" id="name" name="name" placeholder="Votre nom"
                                    value="<%= formData?.name || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="votre@email.com"
                                    value="<%= formData?.email || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="city">Ville</label>
                                <input type="text" id="city" name="city" placeholder="Votre ville"
                                    value="<%= formData?.city || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="phone">Téléphone (optionnel)</label>
                                <input type="tel" id="phone" name="phone" placeholder="+225 XX XX XX XX"
                                    value="<%= formData?.phone || '' %>">
                            </div>

                            <div class="form-group">
                                <label for="password">Mot de passe</label>
                                <input type="password" id="password" name="password" placeholder="Au moins 8 caractères"
                                    required>
                                <small>Minimum 8 caractères pour la sécurité</small>
                            </div>

                            <div class="form-group">
                                <label for="passwordConfirm">Confirmer le mot de passe</label>
                                <input type="password" id="passwordConfirm" name="passwordConfirm"
                                    placeholder="Confirmez votre mot de passe" required>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block">Créer mon compte</button>
                        </form>

                        <p class="auth-link">
                            Vous avez déjà un compte ? <a href="/login">Se connecter</a>
                        </p>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>