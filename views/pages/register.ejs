<%- include('../partials/header') %>
    <main class="container">
        <div class="auth-container">
            <div class="auth-card">
                <img src="/images/logo_nom_slogan_paysage.png" alt="RETROOVA" class="auth-brand-logo">
                <h1><%= t('auth.registerTitle', 'Inscription') %></h1>
                <p><%= t('auth.registerDescription', 'Rejoignez-nous pour retrouver vos objets perdus') %></p>

                <% if (typeof errors !=='undefined' && errors.length> 0) { %>
                    <div class="alert alert-danger">
                        <% errors.forEach(error=> { %>
                            <p>❌ <%= error %>
                            </p>
                            <% }); %>
                    </div>
                    <% } %>

                        <form method="POST" action="/register" class="auth-form"><input type="hidden" name="_csrf"
                                value="<%= csrfToken %>">
                            <div class="form-group">
                                <label for="name"><%= t('profile.fullName', 'Nom complet') %></label>
                                <input type="text" id="name" name="name" placeholder="<%= t('auth.namePlaceholder', 'Votre nom') %>"
                                    value="<%= formData?.name || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="email"><%= t('common.email', 'Email') %></label>
                                <input type="email" id="email" name="email" placeholder="votre@email.com"
                                    value="<%= formData?.email || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="city"><%= t('profile.city', 'Ville') %></label>
                                <input type="text" id="city" name="city" placeholder="<%= t('auth.cityPlaceholder', 'Votre ville') %>"
                                    value="<%= formData?.city || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="phone"><%= t('profile.phone', 'Téléphone') %> (optionnel)</label>
                                <input type="tel" id="phone" name="phone" placeholder="+225 XX XX XX XX"
                                    value="<%= formData?.phone || '' %>">
                            </div>

                            <div class="form-group">
                                <label for="password"><%= t('common.password', 'Mot de passe') %></label>
                                <input type="password" id="password" name="password" placeholder="<%= t('auth.passwordPlaceholder', 'Au moins 8 caractères') %>"
                                    required>
                                <small><%= t('auth.passwordHint', 'Minimum 8 caractères pour la sécurité') %></small>
                            </div>

                            <div class="form-group">
                                <label for="passwordConfirm"><%= t('auth.confirmPassword', 'Confirmer le mot de passe') %></label>
                                <input type="password" id="passwordConfirm" name="passwordConfirm"
                                    placeholder="<%= t('auth.confirmPasswordPlaceholder', 'Confirmez votre mot de passe') %>" required>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block"><%= t('auth.createAccount', 'Créer mon compte') %></button>
                        </form>

                        <p class="auth-link">
                            <%= t('auth.alreadyHaveAccount', 'Vous avez déjà un compte ?') %> <a href="/login"><%= t('auth.submitLogin', 'Se connecter') %></a>
                        </p>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>