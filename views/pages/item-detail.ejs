<%- include('../partials/header') %>
    <main class="container item-detail-page">
        <a href="/search" class="back-link detail-back-link">← <%= t('itemDetail.backToResults', 'Retour aux résultats') %></a>
        <% if (typeof message !== 'undefined' && message) { %><div class="alert alert-success"><p>✅ <%= message %></p></div><% } %>

        <article class="item-detail-card">
            <div class="detail-hero">
                <div class="detail-copy">
                    <div class="detail-badges"><span class="type-pill <%= item.type %>"><%= item.type === 'lost' ? t('itemDetail.typeLost', 'OBJET PERDU') : t('itemDetail.typeFound', 'OBJET TROUVÉ') %></span><span class="detail-status status-<%= item.status %>"><%= { active: t('itemDetail.statusActive', 'Active'), matched: t('itemDetail.statusMatched', 'Correspondance'), in_contact: t('itemDetail.statusInContact', 'En contact'), returned: t('itemDetail.statusReturned', 'Objet restitué'), closed: t('itemDetail.statusClosed', 'Fermé'), expired: t('itemDetail.statusExpired', 'Expiré') }[item.status] || item.status || t('itemDetail.statusUnknown', 'Non précisé') %></span></div>
                    <h1><%= item.title %></h1>
                    <div class="detail-quick-facts">
                        <span>📍 <strong><%= item.district ? item.district + ' · ' : '' %><%= item.city || t('itemDetail.locationUnknown', 'Lieu non précisé') %></strong></span>
                        <span>📅 <strong><%= item.event_date ? new Date(`${item.event_date}T00:00:00`).toLocaleDateString(locale === 'en' ? 'en-US' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : t('itemDetail.dateUnknown', 'Date non précisée') %></strong></span>
                            <span>🏷️ <strong><%= typeof categoryLabels !== 'undefined' && categoryLabels?.[item.category] || item.category || t('itemDetail.categoryUnknown', 'Catégorie non précisée') %></strong></span>
                    </div>
                </div>
                <div class="detail-media">
                    <% if (item.photo_url) { %><img src="<%= item.photo_url %>" alt="Photo de <%= item.title %>" class="detail-photo" onerror="this.remove()"><% } else { %><div class="detail-photo-empty"><span>⌕</span><strong><%= t('itemDetail.noPhoto', 'Aucune photo disponible') %></strong><small><%= t('itemDetail.noPhotoText', 'L\'annonce ne contient pas d\'image.') %></small></div><% } %>
                </div>
            </div>

            <div class="detail-body-grid">
                <div class="detail-main-column">
                    <section class="detail-section detail-description"><span class="section-label"><%= t('itemDetail.aboutObject', 'À propos de l\'objet') %></span><h2><%= t('itemDetail.description', 'Description') %></h2><p><%= item.description || t('itemDetail.noDescription', 'Aucune description fournie pour le moment.') %></p></section>
                    <section class="detail-section"><span class="section-label"><%= t('itemDetail.info', 'INFORMATIONS') %></span><h2><%= t('itemDetail.detailsTitle', 'Détails de l\'annonce') %></h2><div class="detail-info-grid"><div><span><%= t('itemDetail.category', 'Catégorie') %></span><strong><%= typeof categoryLabels !== 'undefined' && categoryLabels?.[item.category] || item.category || t('common.noData', 'Non précisée') %></strong></div><div><span><%= t('itemDetail.brandModel', 'Marque / modèle') %></span><strong><%= [item.brand, item.model].filter(Boolean).join(' · ') || t('itemDetail.notSpecified', 'Non précisé') %></strong></div><div><span><%= t('itemDetail.color', 'Couleur') %></span><strong><%= item.color || t('itemDetail.notSpecified', 'Non précisée') %></strong></div><div><span><%= t('itemDetail.location', 'Lieu détaillé') %></span><strong><%= item.location_description || t('itemDetail.notSpecified', 'Non précisé') %></strong></div></div></section>
                </div>

                <aside class="detail-side-column">
                        <section class="detail-author-card"><span class="section-label"><%= t('itemDetail.trust', 'CONFIANCE') %></span><div class="detail-author-avatar">👤</div><p class="detail-author-label"><%= t('itemDetail.publishedBy', 'Annonce publiée par') %></p><h2><%= item.is_anonymous ? t('itemDetail.publicMember', 'un membre RETROOVA') : (item.owner_name || t('itemDetail.publicMember', 'un membre RETROOVA')) %></h2><% if (typeof ownerReputation !== 'undefined' && ownerReputation) { %><p class="reputation-badge <%= ownerReputation.tone %>"><%= ownerReputation.tone === 'success' ? t('itemDetail.goodReputation', 'Bonne réputation') : ownerReputation.tone === 'danger' ? t('itemDetail.watchlist', 'Compte sous surveillance') : t('itemDetail.standardReputation', 'Réputation standard') %><span>·</span><%= ownerReputation.level %></p><% } %><% if (item.owner_public_id) { %><div class="detail-public-id"><span><%= t('itemDetail.publicId', 'Identifiant public') %></span><code id="advertiser-id"><%= item.owner_public_id %></code><button type="button" class="copy-id" data-copy-target="#advertiser-id"><%= t('itemDetail.copy', 'Copier') %></button></div><% } %></section>
                    <section class="detail-actions">
                        <span class="section-label"><%= t('itemDetail.whatNext', 'QUE SOUHAITEZ-VOUS FAIRE ?') %></span>
                        <h2><%= t('itemDetail.actOnAd', 'Agir sur cette annonce') %></h2>
                        <% if (user && item.user_id === user.id) { %>
                            <a href="/items/<%= item.id %>/edit" class="btn btn-primary btn-block"><%= t('itemDetail.modifyAd', 'Modifier l\'annonce') %></a>
                            <% if (['active', 'matched', 'in_contact'].includes(item.status)) { %>
                                <form method="POST" action="/items/<%= item.id %>/status" class="detail-form detail-recover-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="status" value="returned">
                                    <button type="submit" class="btn btn-quiet btn-block" onclick="return confirm('<%= t('itemDetail.confirmReturn', 'Confirmer que cet objet a bien été') %> <%= item.type === 'lost' ? t('itemDetail.lostFound', 'retrouvé') : t('itemDetail.lostReturned', 'restitué') %> ?');"><%= item.type === 'lost' ? t('itemDetail.markReturned', '✓ Objet retrouvé') : t('itemDetail.markRestituted', '✓ Objet restitué') %></button>
                                </form>
                            <% } %>
                        <% } else if (user && item.owner_public_id) { %>
                            <a href="/messages?to=<%= item.owner_public_id %>&item=<%= item.id %>" class="btn btn-primary btn-block"><%= t('itemDetail.writeToOwner', 'Écrire à cette personne') %></a>
                            <a href="/matches" class="btn btn-secondary btn-block"><%= t('itemDetail.viewMatches', 'Voir mes correspondances') %></a>
                            <form method="POST" action="/messages" class="detail-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="receiverId" value="<%= item.owner_public_id %>">
                                <input type="hidden" name="itemId" value="<%= item.id %>">
                                <input type="text" name="subject" placeholder="<%= t('itemDetail.subject', 'Sujet') %>">
                                <textarea name="message" rows="3" placeholder="<%= t('itemDetail.message', 'Votre message') %>" required></textarea>
                                <button class="btn btn-secondary btn-block"><%= t('itemDetail.contactPerson', 'Contacter') %></button>
                            </form>
                            <% if (item.type === 'found') { %>
                                <form method="POST" action="/items/<%= item.id %>/proof" class="detail-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <textarea name="proofText" rows="3" placeholder="<%= t('itemDetail.proofPrompt', 'Décrivez un détail privé prouvant votre propriété') %>" required></textarea>
                                    <button class="btn btn-secondary btn-block"><%= t('itemDetail.requestProof', 'Faire une demande de récupération') %></button>
                                </form>
                            <% } %>
                        <% } else if (user) { %>
                            <p class="detail-muted"><%= t('itemDetail.contactReserved', 'Les actions de contact sont réservées à la personne concernée.') %></p>
                        <% } else { %>
                            <a href="/login" class="btn btn-primary btn-block"><%= t('itemDetail.loginToAct', 'Se connecter pour agir') %></a>
                        <% } %>
                        <a href="/items/<%= item.id %>/report" class="detail-report">Signaler cette annonce <span>→</span></a>
                    </section>
                </aside>
            </div>
        </article>

        <% if (matches.length) { %><section class="detail-matches"><div class="surface-heading"><div><span class="section-label"><%= t('itemDetail.analysis', 'ANALYSE RETROOVA') %></span><h2><%= t('itemDetail.potentialMatches', 'Correspondances potentielles') %></h2></div><span class="surface-mark"><%= matches.length.toString().padStart(2, '0') %></span></div><div class="detail-match-list"><% matches.forEach(match => { %><article class="detail-match-row"><span class="match-symbol">✦</span><div><strong><%= match.lost_title %> ↔ <%= match.found_title %></strong><p><%= t('itemDetail.adDescription', 'Une annonce associée à votre recherche.') %></p></div><strong class="match-score"><%= match.score %>%</strong><a href="/matches" class="row-arrow" aria-label="<%= t('itemDetail.matchLabel', 'Voir la correspondance') %>">→</a></article><% }) %></div></section><% } %>
    </main>
    <%- include('../partials/footer') %>
