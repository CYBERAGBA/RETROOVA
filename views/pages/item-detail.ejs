<%- include('../partials/header') %>
    <main class="container item-detail-page">
        <a href="/search" class="back-link detail-back-link">← Retour aux résultats</a>
        <% if (typeof message !== 'undefined' && message) { %><div class="alert alert-success"><p>✅ <%= message %></p></div><% } %>

        <article class="item-detail-card">
            <div class="detail-hero">
                <div class="detail-copy">
                    <div class="detail-badges"><span class="type-pill <%= item.type %>"><%= item.type === 'lost' ? 'OBJET PERDU' : 'OBJET TROUVÉ' %></span><span class="detail-status status-<%= item.status %>"><%= { active: 'Active', matched: 'Correspondance', in_contact: 'En contact', returned: 'Objet restitué', closed: 'Fermé', expired: 'Expiré' }[item.status] || item.status || 'Non précisé' %></span></div>
                    <h1><%= item.title %></h1>
                    <div class="detail-quick-facts">
                        <span>📍 <strong><%= item.district ? item.district + ' · ' : '' %><%= item.city || 'Lieu non précisé' %></strong></span>
                        <span>📅 <strong><%= item.event_date ? new Date(item.event_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Date non précisée' %></strong></span>
                            <span>🏷️ <strong><%= typeof categoryLabels !== 'undefined' && categoryLabels?.[item.category] || item.category || 'Catégorie non précisée' %></strong></span>
                    </div>
                </div>
                <div class="detail-media">
                    <% if (item.photo_url) { %><img src="<%= item.photo_url %>" alt="Photo de <%= item.title %>" class="detail-photo"><% } else { %><div class="detail-photo-empty"><span>⌕</span><strong>Aucune photo disponible</strong><small>L'annonce ne contient pas d'image.</small></div><% } %>
                </div>
            </div>

            <div class="detail-body-grid">
                <div class="detail-main-column">
                    <section class="detail-section detail-description"><span class="section-label">À PROPOS DE L'OBJET</span><h2>Description</h2><p><%= item.description || 'Aucune description fournie pour le moment.' %></p></section>
                    <section class="detail-section"><span class="section-label">INFORMATIONS</span><h2>Détails de l'annonce</h2><div class="detail-info-grid"><div><span>Catégorie</span><strong><%= typeof categoryLabels !== 'undefined' && categoryLabels?.[item.category] || item.category || 'Non précisée' %></strong></div><div><span>Marque / modèle</span><strong><%= [item.brand, item.model].filter(Boolean).join(' · ') || 'Non précisé' %></strong></div><div><span>Couleur</span><strong><%= item.color || 'Non précisée' %></strong></div><div><span>Lieu détaillé</span><strong><%= item.location_description || 'Non précisé' %></strong></div></div></section>
                </div>

                <aside class="detail-side-column">
                        <section class="detail-author-card"><span class="section-label">CONFIANCE</span><div class="detail-author-avatar">👤</div><p class="detail-author-label">Annonce publiée par</p><h2><%= item.is_anonymous ? 'un membre RETROOVA' : (item.owner_name || 'un membre RETROOVA') %></h2><% if (typeof ownerReputation !== 'undefined' && ownerReputation) { %><p class="reputation-badge <%= ownerReputation.tone %>"><%= ownerReputation.tone === 'success' ? 'Bonne réputation' : ownerReputation.tone === 'danger' ? 'Compte sous surveillance' : 'Réputation standard' %><span>·</span><%= ownerReputation.level %></p><% } %><% if (item.owner_public_id) { %><div class="detail-public-id"><span>Identifiant public</span><code id="advertiser-id"><%= item.owner_public_id %></code><button type="button" class="copy-id" data-copy-target="#advertiser-id">Copier</button></div><% } %></section>
                    <section class="detail-actions"><span class="section-label">QUE SOUHAITEZ-VOUS FAIRE ?</span><h2>Agir sur cette annonce</h2><% if (user && item.user_id === user.id) { %><a href="/items/<%= item.id %>/edit" class="btn btn-primary btn-block">Modifier l'annonce</a><% if (['active', 'matched', 'in_contact'].includes(item.status)) { %><form method="POST" action="/items/<%= item.id %>/status" class="detail-form detail-recover-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="returned"><button type="submit" class="btn btn-quiet btn-block" onclick="return confirm('Confirmer que cet objet a bien été <%= item.type === 'lost' ? 'retrouvé' : 'restitué' %> ?');"><%= item.type === 'lost' ? '✓ Objet retrouvé' : '✓ Objet restitué' %></button></form><% } %><% } else if (user && item.owner_public_id) { %><a href="/messages?to=<%= item.owner_public_id %>&item=<%= item.id %>" class="btn btn-primary btn-block">Écrire à cette personne</a><a href="/matches" class="btn btn-secondary btn-block">Voir mes correspondances</a><form method="POST" action="/messages" class="detail-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="receiverId" value="<%= item.owner_public_id %>"><input type="hidden" name="itemId" value="<%= item.id %>"><input type="text" name="subject" placeholder="Sujet"><textarea name="message" rows="3" placeholder="Votre message" required></textarea><button class="btn btn-secondary btn-block">Contacter</button></form><% if (item.type === 'found') { %><form method="POST" action="/items/<%= item.id %>/proof" class="detail-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="proofText" rows="3" placeholder="Décrivez un détail privé prouvant votre propriété" required></textarea><button class="btn btn-secondary btn-block">Faire une demande de récupération</button></form><% } %><% } else if (user) { %><p class="detail-muted">Les actions de contact ne sont pas disponibles pour cette annonce anonyme.</p><% } else { %><a href="/login" class="btn btn-primary btn-block">Se connecter pour agir</a><% } %><a href="/items/<%= item.id %>/report" class="detail-report">Signaler cette annonce <span>→</span></a></section>
                </aside>
            </div>
        </article>

        <% if (matches.length) { %><section class="detail-matches"><div class="surface-heading"><div><span class="section-label">ANALYSE RETROOVA</span><h2>Correspondances potentielles</h2></div><span class="surface-mark"><%= matches.length.toString().padStart(2, '0') %></span></div><div class="detail-match-list"><% matches.forEach(match => { %><article class="detail-match-row"><span class="match-symbol">✦</span><div><strong><%= match.lost_title %> ↔ <%= match.found_title %></strong><p>Une annonce associée à votre recherche.</p></div><strong class="match-score"><%= match.score %>%</strong><a href="/matches" class="row-arrow" aria-label="Voir la correspondance">→</a></article><% }) %></div></section><% } %>
    </main>
    <%- include('../partials/footer') %>
