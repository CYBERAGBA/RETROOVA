<%- include('../partials/header') %>
    <main class="container">
        <div class="form-page">
            <a href="/dashboard" class="back-link">← Retour au tableau de bord</a>
            <div class="page-heading">
                <span class="eyebrow">
                    <%= isEdit ? 'MISE À JOUR' : (formData.type==='lost' ? 'OBJET PERDU' : 'OBJET TROUVÉ' ) %>
                </span>
                <h1>
                    <%= isEdit ? 'Modifier mon annonce' : (formData.type==='lost' ? 'Déclarer un objet perdu'
                        : 'Déclarer un objet trouvé' ) %>
                </h1>
                <p>Donnez assez de détails pour aider la bonne personne à le reconnaître.</p>
            </div>
            <form method="POST" enctype="multipart/form-data"
                action="<%= isEdit ? '/items/' + itemId + '/update' : '/' + formData.type + '/create' %>"
                class="item-form" data-wizard="true" data-edit="<%= isEdit ? 'true' : 'false' %>"
                data-confirm="Publier cette annonce maintenant ?"><input type="hidden" name="_csrf"
                    value="<%= csrfToken %>">
                <div class="form-grid">
                    <div class="form-group form-span-2"><label for="title">Titre de l’annonce *</label><input id="title"
                            name="title" value="<%= formData.title || '' %>" placeholder="Ex. iPhone 13 bleu" required
                            maxlength="120"></div>
                    <div class="form-group"><label for="category">Catégorie *</label><select id="category"
                            name="category" required>
                            <option value="">Sélectionner</option>
                            <% categories.forEach(category=> { %><option value="<%= category %>"
                                    <%=formData.category===category ? 'selected' : '' %>><%= categoryLabels[category] %>
                                </option>
                                <% }) %>
                        </select></div>
                    <div class="form-group"><label for="event_date">Date</label><input id="event_date" type="date"
                            name="event_date" value="<%= formData.event_date || '' %>"></div>
                    <div class="form-group"><label for="city">Ville *</label><input id="city" name="city"
                            value="<%= formData.city || '' %>" placeholder="Ex. Abidjan" required></div>
                    <div class="form-group"><label for="district">Quartier</label><input id="district" name="district"
                            value="<%= formData.district || '' %>" placeholder="Ex. Cocody"></div>
                    <div class="form-group"><label for="brand">Marque</label><input id="brand" name="brand"
                            value="<%= formData.brand || '' %>" placeholder="Ex. Apple"></div>
                    <div class="form-group"><label for="model">Modèle</label><input id="model" name="model"
                            value="<%= formData.model || '' %>" placeholder="Ex. iPhone 13"></div>
                    <div class="form-group"><label for="color">Couleur</label><input id="color" name="color"
                            value="<%= formData.color || '' %>" placeholder="Ex. Bleu nuit"></div>
                    <div class="form-group form-span-2"><label for="location_description">Lieu précis</label><input
                            id="location_description" name="location_description"
                            value="<%= formData.location_description || '' %>"
                            placeholder="Ex. près de l’entrée du supermarché"></div>
                    <div class="form-group form-span-2"><label for="description">Description</label><textarea
                            id="description" name="description" rows="5" maxlength="2000"
                            placeholder="Signes distinctifs, contenu, circonstances..."><%= formData.description || '' %></textarea>
                    </div>
                    <div class="form-group"><label for="photo">Photo</label><input id="photo" type="file" name="photo"
                            accept="image/jpeg,image/png,image/gif,image/webp"><small>5 Mo maximum. JPG, PNG, GIF ou
                            WebP.</small><img id="photo-preview" class="photo-preview" alt="Aperçu de la photo" hidden>
                    </div>
                    <% if (formData.type==='found' ) { %>
                        <div class="form-group"><label><input type="checkbox" name="is_anonymous" value="1"
                                    <%=formData.is_anonymous ? 'checked' : '' %>> Je souhaite rester anonyme</label>
                        </div>
                        <% } %>
                </div>
                <div class="form-actions"><a href="/dashboard" class="btn btn-secondary">Annuler</a><button
                        type="submit" class="btn <%= formData.type === 'found' ? 'btn-success' : 'btn-primary' %>">
                        <%= isEdit ? 'Enregistrer' : 'Publier l’annonce' %>
                    </button></div>
            </form>
        </div>
        </div>
    </main>
    <%- include('../partials/footer') %>