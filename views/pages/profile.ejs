<%- include('../partials/header') %>
    <main class="container profile-page">
        <div class="profile-intro">
            <span class="eyebrow"><%= t('profile.personalSpace', 'ESPACE PERSONNEL') %></span>
            <h1><%= t('profile.title', 'Mon profil') %></h1>
            <p><%= t('profile.intro', 'Votre identité RETROOVA, vos repères et votre activité au même endroit.') %></p>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success"><p>✅ <%= message %></p></div>
        <% } %>

        <section class="profile-hero-panel">
            <div class="profile-avatar-large" aria-hidden="true">👤</div>
            <div class="profile-hero-copy">
                <p class="profile-kicker"><%= t('profile.memberRet', 'MEMBRE RETROOVA') %></p>
                <h2><%= user?.name || 'Membre RETROOVA' %></h2>
                <p class="profile-member-since"><%= t('profile.memberSince', 'Membre depuis') %> <%= formatDate(user?.created_at) || 'votre inscription' %></p>
                <p class="reputation-badge <%= reputation?.tone || 'standard' %>"><%= reputation?.tone === 'success' ? t('dashboard.reputationGood', 'Bonne réputation') : reputation?.tone === 'danger' ? t('dashboard.reputationWarning', 'Compte sous surveillance') : t('dashboard.reputationStandard', 'Réputation standard') %><span>·</span><%= reputation?.level || t('dashboard.memberNew', 'Nouveau membre') %></p>
            </div>
            <div class="profile-verifications">
                <span class="verification-pill <%= stats?.email_verified ? 'is-verified' : '' %>"><%= stats?.email_verified ? '✓' : '○' %> <%= t('profile.emailVerified', 'Email vérifié') %></span>
                <span class="verification-pill <%= stats?.phone_verified ? 'is-verified' : '' %>"><%= stats?.phone_verified ? '✓' : '○' %> <%= t('profile.phoneVerified', 'Téléphone vérifié') %></span>
            </div>
        </section>

        <section class="profile-stat-grid" aria-label="<%= t('profile.statsLabel', 'Statistiques du profil') %>">
            <div class="profile-stat-card accent-blue"><strong><%= profileStats?.lost || 0 %></strong><span><%= t('profile.statsLost', 'Objets perdus') %></span><small><%= t('profile.declarations', 'Déclarations') %></small></div>
            <div class="profile-stat-card accent-orange"><strong><%= profileStats?.found || 0 %></strong><span><%= t('profile.statsFound', 'Objets trouvés') %></span><small><%= t('profile.contributions', 'Contributions') %></small></div>
            <div class="profile-stat-card accent-green"><strong><%= profileStats?.returned || 0 %></strong><span><%= t('profile.statsReturned', 'Objets restitués') %></span><small><%= t('profile.confirmed', 'Confirmés') %></small></div>
            <div class="profile-stat-card accent-navy"><strong><%= profileStats?.matches || 0 %></strong><span><%= t('profile.statsMatches', 'Correspondances') %></span><small><%= t('profile.potential', 'Potentielles') %></small></div>
        </section>

        <div class="profile-content-grid">
            <section class="profile-surface">
                <div class="surface-heading"><div><span class="section-label"><%= t('profile.yourData', 'Vos données') %></span><h2><%= t('profile.personalInfo', 'Informations personnelles') %></h2></div><span class="surface-mark">01</span></div>
                <form method="POST" action="/profile/update" class="profile-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="profile-form-grid">
                        <label class="form-group"><span><%= t('profile.fullName', 'Nom complet') %></span><input type="text" name="name" value="<%= user?.name || '' %>" required></label>
                        <label class="form-group"><span><%= t('common.email', 'Email') %></span><input type="email" value="<%= user?.email || '' %>" disabled><small><%= t('profile.emailDisabled', 'L\'email ne peut pas être changé.') %></small></label>
                        <label class="form-group"><span><%= t('profile.city', 'Ville') %></span><input type="text" name="city" value="<%= user?.city || '' %>" required></label>
                        <label class="form-group"><span><%= t('profile.phone', 'Téléphone') %></span><input type="tel" name="phone" placeholder="+225 XX XX XX XX" value="<%= user?.phone || '' %>"></label>
                    </div>
                    <button type="submit" class="btn btn-primary"><%= t('profile.saveChanges', 'Enregistrer les modifications') %></button>
                </form>
            </section>

            <section class="profile-surface profile-activity-surface">
                <div class="surface-heading"><div><span class="section-label"><%= t('profile.history', 'Votre historique') %></span><h2><%= t('profile.recentActivity', 'Activité récente') %></h2></div><span class="surface-mark">02</span></div>
                <% if (activity?.length) { %>
                    <div class="activity-list">
                        <% activity.forEach(entry => { %><article class="activity-entry"><span class="activity-icon"><%= entry.type === 'match' ? '✦' : '•' %></span><div><strong><%= entry.title %></strong><p><%= entry.detail %></p></div><time><%= formatDate(entry.date) %></time></article><% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state"><span>✦</span><p><%= t('profile.notAvailable', 'Votre activité apparaîtra ici.') %></p></div>
                <% } %>
            </section>
        </div>

        <section class="profile-surface profile-security-surface">
            <div class="surface-heading"><div><span class="section-label"><%= t('profile.security', 'Accès et confiance') %></span><h2><%= t('profile.reputation', 'Votre réputation') %></h2></div><span class="surface-mark">03</span></div>
            <div class="reputation-summary"><div class="reputation-dot <%= reputation?.tone || 'standard' %>"></div><div><strong><%= reputation?.level || t('dashboard.memberNew', 'Nouveau membre') %></strong><p><%= t('profile.reputationText', 'Un statut fondé sur vos actions vérifiables chez RETROOVA.') %></p></div><a href="/dashboard" class="text-link"><%= t('profile.viewDashboard', 'Voir mon tableau de bord') %> <span>→</span></a></div>
        </section>
    </main>
    <%- include('../partials/footer') %>
