<%- include('../partials/header') %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <main class="container">
        <div class="page-heading"><span class="eyebrow"><%= t('adminDetail.mapEyebrow', 'VUE LOCALE') %></span>
            <h1><%= t('adminDetail.mapTitle', 'Carte des annonces') %></h1>
            <p><%= t('adminDetail.mapIntro', 'Explorez les annonces actives par ville et quartier.') %></p>
        </div>
        <div class="map-layout">
            <section class="map-visual">
                <div id="retroova-map" class="leaflet-map"></div>
            </section>
            <section class="map-results">
                <h2>
                    <%= results.length %> annonce<%= results.length !==1 ? 's' : '' %>
                </h2>
                <% results.forEach(item=> { %><a class="map-result" href="/items/<%= item.id %>"><span
                            class="type-pill <%= item.type %>">
                            <%= item.type %>
                        </span><strong>
                            <%= item.title %>
                        </strong><small>
                            <%= item.city %>
                                <%= item.district ? ' · ' + item.district : '' %>
                        </small></a>
                    <% }) %>
            </section>
        </div>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>const retroovaItems = <%- JSON.stringify(results.map(item => ({ id: item.id, title: item.title, type: item.type, city: item.city, district: item.district }))).replace(/</g, '\\u003c') %>;</script>
        <script src="/js/map.js"></script>
    </main>
    <%- include('../partials/footer') %>