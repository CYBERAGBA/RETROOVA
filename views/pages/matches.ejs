<%- include('../partials/header') %>
    <main class="container">
        <div class="page-heading"><span class="eyebrow"><%= t('matchesPage.eyebrow', 'INTELLIGENCE RETROOVA') %></span>
            <h1><%= t('matchesPage.title', 'Mes correspondances') %></h1>
            <p><%= t('matchesPage.intro', 'Les annonces compatibles sont classées par score de confiance.') %></p>
        </div>
        <% if (!matches.length) { %>
            <div class="empty-state">
                <div class="empty-mark">↗</div>
                <h3><%= t('matchesPage.emptyTitle', 'Pas encore de correspondance') %></h3>
                <p><%= t('matchesPage.emptyText', 'Publiez une annonce détaillée pour activer le matching automatique.') %></p>
            </div>
            <% } else { %>
                <div class="match-list">
                    <% matches.forEach(match=> { %><article class="match-card">
                            <div class="match-score"><strong>
                                    <%= match.score %>%
                                </strong><span>
                                        <% if (match.score>= 70) { %><%= t('matchesPage.strong', 'Forte correspondance') %><% } else if (match.score>= 40) {
                                            %><%= t('matchesPage.possible', 'Correspondance possible') %><% } else { %><%= t('matchesPage.weak', 'Faible correspondance') %><% } %>
                                </span></div>
                            <div class="match-copy">
                                <h3>
                                    <%= match.lost_title %> ↔ <%= match.found_title %>
                                </h3>
                                <p>
                                    <%= match.lost_city %> · <%= match.found_city %>
                                </p><small><%= t('matchesPage.suggestion', 'Suggestion générée automatiquement') %></small>
                            </div><span class="match-status">
                                <%= match.status %>
                            </span>
                            <% if (match.status==='confirmed' ) { %>
                                <form method="POST" action="/matches/<%= match.id %>/returned" class="inline-form"
                                    data-confirm="<%= t('matchesPage.confirmReturn', 'Confirmer que l’objet a été restitué ?') %>">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="btn btn-small btn-success" type="submit">
                                        <%= match.found_owner_id===user.id ? t('matchesPage.returned', 'Objet restitué') : t('matchesPage.myFound', 'Mon objet trouvé') %>
                                    </button>
                                </form>
                                <% } %>
                                    <% if (match.status==='pending' ) { %>
                                        <form method="POST" action="/matches/<%= match.id %>/accept"
                                            class="inline-form"><input type="hidden" name="_csrf"
                                                value="<%= csrfToken %>"><button class="btn btn-small btn-success"
                                                type="submit"><%= t('matchesPage.accept', 'Accepter') %></button></form>
                                        <form method="POST" action="/matches/<%= match.id %>/reject"
                                            class="inline-form"><input type="hidden" name="_csrf"
                                                value="<%= csrfToken %>"><button class="btn btn-small btn-secondary"
                                                type="submit"><%= t('matchesPage.reject', 'Refuser') %></button></form>
                                        <% } %>
                        </article>
                        <% }) %>
                </div>
                <% } %>
    </main>
    <%- include('../partials/footer') %>