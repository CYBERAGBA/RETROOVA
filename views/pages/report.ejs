<%- include('../partials/header') %>
    <main class="container">
        <div class="form-page">
            <a href="/items/<%= item.id %>" class="back-link">Retour à l’annonce</a>
            <div class="page-heading"><span class="eyebrow">MODÉRATION</span>
                <h1>Signaler une annonce</h1>
                <p>Votre signalement sera examiné par l’équipe RETROOVA.</p>
            </div>
            <form method="POST" action="/items/<%= item.id %>/report" class="item-form"><input type="hidden"
                    name="_csrf" value="<%= csrfToken %>">
                <div class="form-group"><label for="reason">Motif *</label><select id="reason" name="reason" required>
                        <option value="">Sélectionner</option>
                        <option>Fausse annonce</option>
                        <option>Arnaque</option>
                        <option>Contenu inapproprié</option>
                        <option>Informations personnelles</option>
                        <option>Objet suspect</option>
                        <option>Autre</option>
                    </select></div>
                <div class="form-group"><label for="description">Détails</label><textarea id="description"
                        name="description" rows="6"
                        placeholder="Expliquez le problème sans communiquer d’informations sensibles."></textarea>
                </div>
                <button class="btn btn-danger" type="submit">Envoyer le signalement</button>
            </form>
        </div>
    </main>
    <%- include('../partials/footer') %>