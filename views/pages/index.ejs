<%- include('../partials/header') %>
    <main class="home-page">
        <section class="home-hero container">
            <div class="hero-copy">
                <div class="hero-brand hero-brand-wide">
                    <img src="/images/logo_nom_slogan_paysage.png" alt="Logo RETROOVA">
                </div>
                <h1><%= t('home.headline', 'Vous avez perdu quelque chose ?') %></h1>
                <h2><%= t('home.subheadline', 'Ne désespérez pas !') %></h2>
                <p class="hero-lead"><%= t('home.lead', 'Quelqu\'un l\'a peut-être retrouvé.') %></p>
                <p class="hero-description"><%= t('home.description', 'RETROOVA connecte les personnes qui ont perdu un objet avec celles qui l\'ont retrouvé.') %></p>

                <form class="home-search" method="GET" action="/<%= locale === 'en' ? 'en/' : 'fr/' %>search">
                    <label class="search-field search-keyword">
                        <span aria-hidden="true">⌕</span>
                        <input type="text" name="keyword" placeholder="<%= t('common.searchPlaceholder', 'Que recherchez-vous ?') %>" aria-label="<%= t('common.searchPlaceholder', 'Que recherchez-vous ?') %>">
                    </label>
                    <label class="search-field">
                        <span aria-hidden="true">▦</span>
                        <select name="category" aria-label="<%= t('common.category', 'Catégorie') %>">
                            <option value=""><%= t('common.category', 'Catégorie') %></option>
                            <% ['phone','wallet','bank-card','id-card','passport','license','documents','keys','jewelry','bag','computer','tablet','luggage','clothing','electronics','birth-certificate','cmu-card','money-card','book','notebook','other-things','other'].forEach((category) => { %>
                                <option value="<%= category %>"><%= t('categories.' + category, category) %></option>
                            <% }); %>
                        </select>
                    </label>
                    <label class="search-field">
                        <span aria-hidden="true">⌖</span>
                        <input type="text" name="city" placeholder="<%= t('common.city', 'Ville') %>" aria-label="<%= t('common.city', 'Ville') %>">
                    </label>
                    <button type="submit" class="home-search-button"><%= t('common.submit', 'Rechercher') %></button>
                </form>

                <div class="hero-actions">
                    <a href="/<%= locale === 'en' ? 'en/' : 'fr/' %>lost/create" class="home-action lost-action"><%= t('home.lostAction', 'J\'AI PERDU UN OBJET') %></a>
                    <a href="/<%= locale === 'en' ? 'en/' : 'fr/' %>found/create" class="home-action found-action"><%= t('home.foundAction', 'J\'AI TROUVÉ UN OBJET') %></a>
                </div>
            </div>
            <div class="hero-visual" aria-label="Illustration d'une personne qui a perdu un objet">
                <div class="hero-pin">⌖</div>
                <img src="/images/femme_desesperee_fond_transparent.png" alt="Une femme désespérée cherche un objet perdu" class="hero-woman">
            </div>
        </section>

        <section class="home-stats container" aria-label="Statistiques RETROOVA">
            <div class="home-stat">
                <span class="stat-symbol blue">◫</span>
                <div>
                    <strong><%= publicStats?.declared || 0 %></strong>
                    <span><%= t('home.statsDeclared', 'Objets déclarés') %></span>
                </div>
            </div>
            <div class="home-stat">
                <span class="stat-symbol orange">⌕</span>
                <div>
                    <strong><%= publicStats?.matches || 0 %></strong>
                    <span><%= t('home.statsMatches', 'Annonces trouvées') %></span>
                </div>
            </div>
            <div class="home-stat">
                <span class="stat-symbol green">✓</span>
                <div>
                    <strong><%= publicStats?.returned || 0 %></strong>
                    <span><%= t('home.statsReturned', 'Objets retournés') %></span>
                </div>
            </div>
            <div class="home-stat">
                <span class="stat-symbol navy">◎</span>
                <div>
                    <strong><%= publicStats?.users || 0 %></strong>
                    <span><%= t('home.statsUsers', 'Utilisateurs') %></span>
                </div>
            </div>
        </section>

        <section class="brand-message container">
            <span>♥</span>
            <p><%= t('home.brandLine', 'Parce que chaque objet a une histoire.') %><br><em><%= t('home.brandLineAccent', 'Et chaque histoire mérite une fin heureuse.') %></em></p>
        </section>
    </main>
    <%- include('../partials/footer') %>